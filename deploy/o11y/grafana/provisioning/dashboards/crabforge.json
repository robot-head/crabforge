{
  "uid": "crabforge-overview",
  "title": "Crabforge",
  "description": "The four things that go wrong: git gets slow, the read model falls behind, CI stops draining, webhooks stop arriving.",
  "tags": ["crabforge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Git",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Smart-HTTP latency (p50 / p95)",
      "description": "Includes cache hydration, which is the slow part of a first clone after the cache is dropped.",
      "datasource": { "type": "prometheus", "uid": "crabka-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, service) (rate(forge_git_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(forge_git_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service}} p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Git requests by outcome",
      "datasource": { "type": "prometheus", "uid": "crabka-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*error.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, result) (rate(forge_git_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Projection",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Projection lag",
      "description": "Age of the newest event each projector has applied, and zero once it has caught up — so a quiet topic reads as current rather than hours behind. This is what a request that returned 202 \"saving…\" is waiting on.",
      "datasource": { "type": "prometheus", "uid": "crabka-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "forge_projection_lag_seconds",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Events applied",
      "description": "Flat while lag is non-zero means a wedged projector rather than an idle one.",
      "datasource": { "type": "prometheus", "uid": "crabka-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(forge_projection_applied_total[$__rate_interval]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Crab Actions",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Jobs queued",
      "description": "The series KEDA scales runners on. A line that climbs and never returns to zero is a queue no number of runners is draining — check that the broker serves share groups.",
      "datasource": { "type": "prometheus", "uid": "crabka-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "forge_ci_jobs_queued", "legendFormat": "queued" }]
    },
    {
      "type": "timeseries",
      "title": "Time waiting for a runner (p95)",
      "datasource": { "type": "prometheus", "uid": "crabka-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(forge_ci_job_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 wait"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job outcomes",
      "description": "infra_failed is the one to watch: it means jobs are not running, rather than running and failing.",
      "datasource": { "type": "prometheus", "uid": "crabka-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "infra_failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(forge_ci_job_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Webhooks",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Delivery attempts by outcome",
      "description": "`dead` is a delivery that exhausted its retries and went to the dead-letter topic. Non-zero and sustained means an integration has stopped working and nobody has been told.",
      "datasource": { "type": "prometheus", "uid": "crabka-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "dead" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "delivered" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(forge_webhook_deliveries_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Delivery latency (p95)",
      "description": "The receiver's time, mostly. Rising here precedes rising retries.",
      "datasource": { "type": "prometheus", "uid": "crabka-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(forge_webhook_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "row",
      "title": "The broker underneath",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "collapsed": true,
      "panels": [
        {
          "type": "timeseries",
          "title": "Messages in",
          "description": "One broker serves the forge, gres's write-ahead log and this observability stack. Which is the point — but it also means a spike here may have nothing to do with the forge.",
          "datasource": { "type": "prometheus", "uid": "crabka-prom" },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
          "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(crabka_broker_messages_in_total[$__rate_interval]))",
              "legendFormat": "messages/s"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Log cleaner",
          "description": "Compaction only runs on sealed segments, which is why the compacted topics are provisioned with a small `segment.bytes`. Flat at zero on a busy forge means superseded git objects are never being reclaimed.",
          "datasource": { "type": "prometheus", "uid": "crabka-prom" },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
          "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(increase(crabka_broker_log_compactions_total[$__rate_interval]))",
              "legendFormat": "compactions"
            },
            {
              "refId": "B",
              "expr": "sum(increase(crabka_broker_log_cleaner_runs_total[$__rate_interval]))",
              "legendFormat": "cleaner runs"
            }
          ]
        }
      ]
    }
  ]
}
